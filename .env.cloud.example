# Non-secret values for local read-only tooling. Regular MWAA receives the
# equivalent Airflow Variables from the `airflow_variables` Terraform output.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=<terraform-output-aws-account-id>
REDSHIFT_HOST=<terraform-output-redshift-serverless-host>
REDSHIFT_WORKGROUP_NAME=<terraform-output-redshift-serverless-workgroup-name>
REDSHIFT_DATABASE=<terraform-output-redshift-database-name>

# No source checksum is configured here. The upstream producer must land each
# immutable object with `sha256` S3 metadata; the DAG reads identity by HEAD.
AIRFLOW_VAR_NYC_LANDING_URI=s3://<bucket>/landing
AIRFLOW_VAR_NYC_TAXI_ZONE_URI=s3://<bucket>/reference/taxi_zone_lookup.csv
AIRFLOW_VAR_NYC_SPARK_SCRIPT_PREFIX_URI=s3://<bucket>/spark_jobs
AIRFLOW_VAR_NYC_SPARK_PACKAGE_URI=s3://<bucket>/spark_jobs/nyc_spark_jobs.zip
AIRFLOW_VAR_NYC_EMR_LOG_URI=s3://<bucket>/emr-logs
AIRFLOW_VAR_NYC_EMR_SERVICE_ROLE_ARN=<terraform-output-emr-service-role-arn>
AIRFLOW_VAR_NYC_EMR_EC2_INSTANCE_PROFILE=<terraform-output-emr-ec2-instance-profile>
AIRFLOW_VAR_NYC_EMR_SUBNET_IDS=["subnet-private-az-a","subnet-private-az-b"]
AIRFLOW_VAR_NYC_WAREHOUSE_URI=s3://<bucket>/warehouse
AIRFLOW_VAR_NYC_PUBLICATION_PREFIX_URI=s3://<bucket>/manifests
AIRFLOW_VAR_REDSHIFT_HOST=<terraform-output>
AIRFLOW_VAR_REDSHIFT_DATABASE=<terraform-output>
AIRFLOW_VAR_REDSHIFT_WORKGROUP_NAME=<terraform-output>
AIRFLOW_VAR_AWS_ACCOUNT_ID=<terraform-output>
AIRFLOW_VAR_AWS_REGION=us-east-1
